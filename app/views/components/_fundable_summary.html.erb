<%# locals: (items:, total:, allocated:, breakdown:) %>
<%
  funded_count = items.count(&:fully_funded?)
  needs_count = items.size - funded_count
  overall_percent = total.positive? ? ((allocated / total) * 100).clamp(0, 100) : 0
%>
<div class="bg-base-200 rounded-xl p-4 mb-4">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <div>
      <div class="text-xs text-base-content/60">Allocated / Total</div>
      <div class="text-2xl font-bold tabular-nums leading-tight">
        <%= number_to_currency(allocated) %>
        <span class="text-base font-normal text-base-content/40">/ <%= number_to_currency(total) %></span>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <span class="badge badge-sm gap-1.5 border-none bg-base-content/8 text-base-content/80">
        <span class="h-1.5 w-1.5 rounded-full bg-success"></span>Fully funded <%= funded_count %>
      </span>
      <span class="badge badge-sm gap-1.5 border-none bg-base-content/8 text-base-content/80">
        <span class="h-1.5 w-1.5 rounded-full bg-primary"></span>Needs funding <%= needs_count %>
      </span>
    </div>
  </div>

  <div class="mt-3 h-1.5 rounded-full bg-base-content/10 overflow-hidden">
    <div class="h-full rounded-full bg-primary" style="width: <%= overall_percent %>%"></div>
  </div>

  <div class="flex flex-wrap gap-2 mt-3">
    <% breakdown.each do |schedule, amount| %>
      <span class="text-xs bg-base-content/6 rounded-lg px-2.5 py-1.5">
        <span class="text-base-content/60">From <%= schedule.name %></span>
        <span class="font-semibold tabular-nums">&middot; <%= number_to_currency(amount) %>/paycheck</span>
      </span>
    <% end %>
  </div>
</div>
